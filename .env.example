# Copy to .env and fill in.

# OpenAI-compatible API key (OPENROUTER_API_KEY also works)
OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible gateway, e.g. OpenRouter
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional: request timeout (s) and retries
# OPENAI_HTTP_TIMEOUT_SEC=120
# OPENAI_MAX_RETRIES=3

# lm_human web app only
# SCENARIOS_DIR=/absolute/path/to/dataset/scenarios
# DB_PATH=/absolute/path/to/negotiations.db
# DOWNLOAD_KEY=choose-a-secret   # required to enable /download_db
